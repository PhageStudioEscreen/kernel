    tristate

config RTW88_8814A
    tristate

config RTW88_8821A
    tristate

config RTW88_8821C
    tristate

config RTW88_8822B
    tristate

config RTW88_8822C
    tristate

config RTW88_8723DE
    tristate "Realtek 8723DE PCI wireless network adapter"
    depends on PCI
    select RTW88_CORE
    select RTW88_PCI
    select RTW88_8723D
    help
      802.11n PCIe wireless network adapter.

