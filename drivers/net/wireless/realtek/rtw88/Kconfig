menuconfig RTW88
    tristate "Realtek 802.11n/ac wireless chips support (rtw88 new)"
    depends on MAC80211
    help
      This module adds support for mac80211-based wireless drivers that
      enables Realtek IEEE 802.11n/ac wireless chipsets.

      If you choose to build a module, it'll be called rtw88_new.

if RTW88

config RTW88_CORE
    tristate

config RTW88_PCI
    tristate

config RTW88_USB
    tristate

config RTW88_SDIO
    tristate
    depends on MMC

config RTW88_8703B
    tristate

config RTW88_8723X
    tristate

config RTW88_8723D
    tristate
    select RTW88_8723X

config RTW88_8812A
    tristate

