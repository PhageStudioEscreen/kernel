menu "UART HID support"
	depends on SERIAL_DEV_BUS

config UART_HID_OF
	tristate "HID over UART transport layer Open Firmware driver"
	default n
	depends on SERIAL_DEV_BUS && INPUT && OF
	help
	  Say Y here if you use a keyboard, a touchpad, a touchscreen, or any
	  other HID based devices which is connected to your computer via UART.
	  This driver supports Open Firmware (Device Tree)-based systems.

	  If unsure, say N.

	  This support is also available as a module.  If so, the module
	  will be called uart-hid-of.  It will also build/depend on the
	  module uart-hid.

endmenu

config UART_HID_CORE
	tristate
	default y if UART_HID_OF=y
	default m if UART_HID_OF=m
	select HID
